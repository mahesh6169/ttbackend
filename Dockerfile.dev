# Local development image, used only by compose.yaml.
# Prod does NOT use this file: Fly builds ./Dockerfile (see fly.toml).
# Same Node as prod (./Dockerfile) so dev matches prod.
FROM node:22.7.0

WORKDIR /app

# Pre-create the dirs that become named volumes so they are owned by the
# "node" user (uid 1000), not root. Source code is bind-mounted at runtime.
RUN mkdir -p /app/node_modules && chown -R node:node /app

USER node

EXPOSE 5020

# Install deps only when package-lock.json changed (npm ci never rewrites
# the lock file), then start nodemon.
CMD ["sh", "-c", "h=$(sha1sum package-lock.json | cut -d' ' -f1); [ \"$(cat node_modules/.lockhash 2>/dev/null)\" = \"$h\" ] || { npm ci && echo \"$h\" > node_modules/.lockhash; }; exec npm run dev"]
